<Window
    x:Class="ThemeStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="ChatGPT Desktop Theme Studio">
    <Grid Background="#10131A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#151923" BorderBrush="#252B37" BorderThickness="0,0,1,0">
            <StackPanel Margin="18,24" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#4F8EF7"><TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" /></Border>
                    <StackPanel><TextBlock x:Uid="BrandTitle" Text="Theme Studio" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Uid="BrandSubtitle" Text="CHATGPT DESKTOP" FontSize="9" Foreground="#A6ADBB"/></StackPanel>
                </StackPanel>
                <TextBlock x:Uid="WorkspaceLabel" Text="WORKSPACE" Margin="0,18,0,0" FontSize="10" Foreground="#7D8594" />
                <RadioButtons x:Name="ViewButtons" SelectionChanged="OnViewChanged" SelectedIndex="0">
                    <RadioButton x:Uid="ChatView" Content="Chat" Tag="chat" />
                    <RadioButton x:Uid="WorkView" Content="Work" Tag="work" />
                    <RadioButton x:Uid="CodexView" Content="Codex" Tag="codex" />
                </RadioButtons>
                <Button x:Uid="SyncViewsButton" Content="Sync theme across views" Click="OnSyncViews" HorizontalAlignment="Stretch" />
                <Border Background="#202532" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="LiveAdapterTitle" Text="Live adapter" FontWeight="SemiBold" />
                        <TextBlock x:Uid="AdapterStatus" x:Name="AdapterStatus" Text="Not verified" TextWrapping="Wrap" FontSize="12" Foreground="#F2C879" />
                        <Button x:Uid="ProbeAdapterButton" Content="Check local connection" Click="OnProbeAdapter" />
                    </StackPanel>
                </Border>
                <TextBlock x:Uid="PrivacyStatement" Text="No conversation data is read or uploaded." TextWrapping="Wrap" FontSize="11" Foreground="#7D8594" Margin="0,24,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel><TextBlock x:Uid="EditorTitle" Text="Theme editor" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Uid="EditorSubtitle" Text="Create a look for this workspace view." Foreground="#A6ADBB" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Uid="NewThemeButton" Content="New theme" Click="OnNewTheme" />
                    <Button x:Uid="ImportThemeButton" Content="Import theme" Click="OnImportTheme" />
                    <Button x:Uid="ExportThemeButton" Content="Export theme" Click="OnExportTheme" />
                    <Button x:Uid="SafeLaunchButton" Content="Safe launch" IsEnabled="False" ToolTipService.ToolTip="Disabled until a ChatGPT client version is verified." />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Background="#171B24" BorderBrush="#252B37" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="ThemeSection" Text="Theme" FontSize="17" FontWeight="SemiBold" />
                                <ComboBox x:Uid="LocalThemesBox" x:Name="LocalThemesBox" Header="Local themes" SelectionChanged="OnLocalThemeChanged" />
                                <TextBlock x:Uid="ThemeNameLabel" Text="Theme name" Foreground="#A6ADBB" FontSize="12" />
                                <TextBox x:Uid="ThemeNameBox" x:Name="ThemeNameBox" PlaceholderText="My theme" TextChanged="OnThemeNameChanged" />
                            </StackPanel>
                        </Border>
                        <Border Background="#171B24" BorderBrush="#252B37" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="BackgroundSection" Text="Background" FontSize="17" FontWeight="SemiBold" />
                                <ComboBox x:Uid="BackgroundKindBox" x:Name="BackgroundKindBox" Header="Type" SelectionChanged="OnBackgroundKindChanged" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="SolidBackground" Content="Solid color" Tag="Solid"/><ComboBoxItem x:Uid="GradientBackground" Content="Gradient" Tag="Gradient"/><ComboBoxItem x:Uid="ImageBackground" Content="Image" Tag="Image"/><ComboBoxItem Content="GIF" Tag="Gif"/><ComboBoxItem x:Uid="VideoBackground" Content="Video (MP4 / WebM)" Tag="Video"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Uid="BackgroundColorBox" x:Name="BackgroundColorBox" Header="Color" Text="#151923" Width="150" TextChanged="OnBackgroundColorChanged"/><TextBox x:Uid="GradientEndBox" x:Name="GradientEndBox" Header="Gradient end" Text="#343B58" Width="150" TextChanged="OnBackgroundColorChanged"/></StackPanel>
                                <TextBox x:Uid="BackgroundFileBox" x:Name="BackgroundFileBox" Header="Local media" IsReadOnly="True" PlaceholderText="No media selected" />
                                <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="ChooseFileButton" Content="Choose file" Click="OnChooseMedia"/><Button x:Uid="PausePreviewButton" x:Name="PausePreviewButton" Content="Pause preview" Click="OnTogglePreview"/></StackPanel>
                                <ComboBox x:Uid="FitBox" x:Name="FitBox" Header="Fit" SelectionChanged="OnBackgroundFitChanged" SelectedIndex="0"><ComboBoxItem x:Uid="FitCover" Content="Cover" Tag="Cover"/><ComboBoxItem x:Uid="FitContain" Content="Contain" Tag="Contain"/><ComboBoxItem x:Uid="FitFill" Content="Fill" Tag="Fill"/></ComboBox>
                                <TextBlock x:Uid="DimLabel" Text="Dark overlay" Foreground="#A6ADBB" FontSize="12"/><Slider x:Name="DimSlider" Minimum="0" Maximum="100" Value="20" ValueChanged="OnBackgroundTuningChanged"/><TextBlock x:Uid="BackgroundBlurLabel" Text="Background blur" Foreground="#A6ADBB" FontSize="12"/><Slider x:Name="BackgroundBlurSlider" Minimum="0" Maximum="40" Value="0" ValueChanged="OnBackgroundTuningChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#171B24" BorderBrush="#252B37" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SelectedSurfaceTitle" Text="Selected surface" FontSize="17" FontWeight="SemiBold" />
                                <ComboBox x:Uid="SurfaceBox" x:Name="SurfaceBox" Header="Region" SelectionChanged="OnSurfaceChanged" SelectedIndex="0"><ComboBoxItem x:Uid="SidebarRegion" Content="Sidebar" Tag="sidebar"/><ComboBoxItem x:Uid="TitlebarRegion" Content="Title bar" Tag="titlebar"/><ComboBoxItem x:Uid="ContentRegion" Content="Content / conversation" Tag="content"/><ComboBoxItem x:Uid="ComposerRegion" Content="Composer" Tag="composer"/><ComboBoxItem x:Uid="MenusRegion" Content="Menus" Tag="menu"/><ComboBoxItem x:Uid="CardsRegion" Content="Cards" Tag="cards"/><ComboBoxItem x:Uid="ControlsRegion" Content="Buttons and controls" Tag="controls"/></ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Uid="SurfaceBackgroundBox" x:Name="SurfaceBackgroundBox" Header="Surface" Text="#202532" Width="150" TextChanged="OnSurfaceTextChanged"/><TextBox x:Uid="SurfaceForegroundBox" x:Name="SurfaceForegroundBox" Header="Text" Text="#F3F5FA" Width="150" TextChanged="OnSurfaceTextChanged"/></StackPanel>
                                <TextBlock x:Uid="OpacityLabel" Text="Opacity" Foreground="#A6ADBB" FontSize="12"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="92" ValueChanged="OnSurfaceTuningChanged"/><TextBlock x:Uid="SurfaceBlurLabel" Text="Blur" Foreground="#A6ADBB" FontSize="12"/><Slider x:Name="SurfaceBlurSlider" Minimum="0" Maximum="40" Value="0" ValueChanged="OnSurfaceTuningChanged"/>
                                <TextBox x:Uid="FontBox" x:Name="FontBox" Header="Font family" Text="Segoe UI Variable Text" TextChanged="OnSurfaceTextChanged"/><TextBlock x:Uid="RadiusLabel" Text="Corner radius" Foreground="#A6ADBB" FontSize="12"/><Slider x:Name="RadiusSlider" Minimum="0" Maximum="48" Value="12" ValueChanged="OnSurfaceTuningChanged"/>
                                <ComboBox x:Uid="ControlStateBox" x:Name="ControlStateBox" Header="Control state" SelectionChanged="OnSurfaceTextChanged" SelectedIndex="0"><ComboBoxItem x:Uid="StateDefault" Content="Default" Tag="default"/><ComboBoxItem x:Uid="StateHover" Content="Hover" Tag="hover"/><ComboBoxItem x:Uid="StatePressed" Content="Pressed" Tag="pressed"/><ComboBoxItem x:Uid="StateDisabled" Content="Disabled" Tag="disabled"/></ComboBox>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="SaveThemeButton" Content="Save local theme" Click="OnSaveTheme"/><Button x:Uid="RestoreDefaultButton" Content="Restore default" Click="OnRestoreDefault"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="#171B24" BorderBrush="#252B37" BorderThickness="1" CornerRadius="16" Padding="16">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><StackPanel><TextBlock x:Uid="PreviewTitle" Text="Preview" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Uid="PreviewSubtitle" Text="Simulated view · not the live ChatGPT app" FontSize="12" Foreground="#A6ADBB"/></StackPanel><TextBlock x:Uid="PreviewWarning" x:Name="PreviewWarning" Text="Preview only" HorizontalAlignment="Right" Foreground="#F2C879" VerticalAlignment="Center"/></Grid>
                        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#303746" BorderThickness="1"><controls:WebView2 x:Name="PreviewWebView" DefaultBackgroundColor="#151923"/></Border>
                        <TextBlock x:Uid="StatusText" x:Name="StatusText" Grid.Row="2" Text="Local theme changes are saved on this device." Foreground="#A6ADBB" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Uid="FooterNote" Grid.Row="2" Text="Theme Studio is independent and unofficial. Live application stays disabled until version-specific validation passes." Foreground="#7D8594" FontSize="11" Margin="0,18,0,0"/>
        </Grid>
    </Grid>
</Window>
