<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThemeStudio</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ThemeStudio\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ThemeStudio\Services\ThemeLibrary.cs" Link="Services\ThemeLibrary.cs" />
    <Compile Include="..\ThemeStudio\Services\ThemePackageService.cs" Link="Services\ThemePackageService.cs" />
  </ItemGroup>
</Project>
